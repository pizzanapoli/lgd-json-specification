{
  "title": "LGD-JSON: Linked Geometry Document Format",
  "upload_type": "software",
  "description": "LGD-JSON is a JSON format for representing geographic, built-environment, and building construction data as a linked graph of typed nodes connected by directed relations. It integrates integer geometry with explicit precision, optional ontology binding, and multi-file distribution support.",
